generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String        @db.LongText
  titleAr       String?       @db.LongText
  description   String?       @db.LongText
  descriptionAr String?       @db.LongText
  client        String?       @db.LongText
  clientAr      String?       @db.LongText
  year          String?       @db.LongText
  category      String?       @db.LongText
  categoryAr    String?       @db.LongText
  tags          Json          @default("[]")
  tagsAr        Json          @default("[]")
  coverImage    String?       @db.LongText
  images        Json          @default("[]")
  videoUrl      String?       @db.LongText
  gifUrl        String?       @db.LongText
  liveUrl       String?       @db.LongText
  githubUrl     String?       @db.LongText
  caseStudyUrl  String?       @db.LongText
  featured      Boolean       @default(false)
  order         Int           @default(0)
  status        ProjectStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Extended fields for web_development project type
  clientId           String?
  projectType        String? @default("web_development")
  tagline            String? @db.LongText
  shortDescription   String? @db.LongText
  fullDescription    String? @db.LongText
  location           String? @db.LongText
  clientLogo         String? @db.LongText
  techStack          Json    @default("[]")
  challengePoints    Json    @default("[]")
  obstacles          Json    @default("[]")
  challengeTagline   String? @db.LongText
  challengeResponses Json    @default("[]")
  solutionOptions    Json    @default("[]")
  clientChoice       Int?
  resultSlides       Json    @default("[]")
  testimonialText    String? @db.LongText
  gallery            Json    @default("[]")
  extraMile          String? @db.LongText
  heroImage          String? @db.LongText
  tallImage          String? @db.LongText
  useTallImage       Boolean @default(false)
  // Which medium fills the pinned project-page frame: "image" or "video".
  heroMediaType      String  @default("image")
  clientGoals        Json    @default("[]")
  challenges         Json    @default("[]")
  results            Json    @default("[]")
  testimonialAuthor  String? @db.LongText
  testimonialRole    String? @db.LongText
  testimonialCompany String? @db.LongText
  extraMilePlanned   String? @db.LongText

  attachments Attachment[]
  services    ProjectService[]
}

model TechItem {
  id        String   @id @default(cuid())
  name      String   @db.LongText
  icon      String?  @db.LongText
  iconUrl   String?  @db.LongText
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientItem {
  id        String   @id @default(cuid())
  name      String   @db.LongText
  company   String?  @db.LongText
  country   String?  @db.LongText
  logo      String?  @db.LongText
  website   String?  @db.LongText
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String   @db.LongText
  nameAr      String?  @db.LongText
  role        String
  roleAr      String?  @db.LongText
  bio         String?  @db.LongText
  bioAr       String?  @db.LongText
  photo       String?  @db.LongText
  linkedinUrl String?  @db.LongText
  twitterUrl  String?  @db.LongText
  email       String?  @db.LongText
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id               String   @id @default(cuid())
  title            String   @db.LongText
  titleAr          String?  @db.LongText
  slug             String   @unique
  description      String?  @db.LongText
  descriptionAr    String?  @db.LongText
  shortDescription String?  @db.LongText
  tagline          String?  @db.LongText
  benefits         Json     @default("[]")
  deliverables     Json     @default("[]")
  process          Json     @default("[]")
  techStack        Json     @default("[]")
  featured         Boolean  @default(false)
  seoTitle         String?  @db.LongText
  seoDescription   String?  @db.LongText
  icon             String?  @db.LongText
  order            Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  faq            Json             @default("[]")
  ctaHeadline    String?          @db.LongText
  ctaSubtext     String?          @db.LongText
  ctaButtonLabel String?          @db.LongText
  ctaButtonLink  String?          @db.LongText
  attachments    Attachment[]
  projects       ProjectService[]
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String   @unique @db.VarChar(768)
  filename     String?  @db.LongText
  originalName String?  @db.LongText
  mimeType     String   @db.LongText
  size         Int
  width        Int?
  height       Int?
  alt          String?  @db.LongText
  caption      String?  @db.LongText
  folder       String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attachments Attachment[]
}

model Attachment {
  id        String   @id @default(cuid())
  mediaId   String
  projectId String?
  serviceId String?
  theme     String?
  role      String
  order     Int      @default(0)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  project Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([projectId, role, theme])
  @@index([serviceId, role, theme])
  @@index([mediaId])
}

model ProjectService {
  projectId String
  serviceId String
  order     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
  @@index([serviceId])
}

model ContactPage {
  id            Int      @id @default(autoincrement())
  headline      String?  @db.LongText
  headlineAr    String?  @db.LongText
  subheadline   String?  @db.LongText
  subheadlineAr String?  @db.LongText
  email         String?  @db.LongText
  phone         String?  @db.LongText
  address       String?  @db.LongText
  addressAr     String?  @db.LongText
  socialLinks   Json     @default("{}")
  updatedAt     DateTime @updatedAt
}

model AboutPage {
  id        Int      @id @default(autoincrement())
  stats     Json     @default("[]")
  story     Json     @default("[]")
  mission   String?  @db.LongText
  vision    String?  @db.LongText
  updatedAt DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String     @db.LongText
  titleAr     String?    @db.LongText
  excerpt     String?    @db.LongText
  excerptAr   String?    @db.LongText
  content     String     @default("") @db.LongText
  contentAr   String?    @db.LongText
  coverImage  String?    @db.LongText
  heroImage   String?    @db.LongText
  tags        Json       @default("[]")
  tagsAr      Json       @default("[]")
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Inquiry {
  id            String        @id @default(cuid())
  name          String        @db.LongText
  email         String        @db.LongText
  projectType   String?       @db.LongText
  message       String        @db.LongText
  contactMethod String?       @db.LongText
  contactValue  String?       @db.LongText
  source        String?       @db.LongText
  audioUrls     Json          @default("[]")
  assetNames    Json          @default("[]")
  metadata      Json          @default("{}")
  status        InquiryStatus @default(NEW)
  notes         String?       @db.LongText
  createdAt     DateTime      @default(now())
}
