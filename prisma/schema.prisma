generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  titleAr       String?
  description   String?       @db.Text
  descriptionAr String?       @db.Text
  client        String?
  clientAr      String?
  year          String?
  category      String?
  categoryAr    String?
  tags          String[]
  tagsAr        String[]      @default([])
  coverImage    String?
  images        String[]
  videoUrl      String?
  gifUrl        String?
  liveUrl       String?
  githubUrl     String?
  caseStudyUrl  String?
  featured      Boolean       @default(false)
  order         Int           @default(0)
  status        ProjectStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Extended fields for web_development project type
  clientId           String?
  projectType        String?   @default("web_development")
  tagline            String?
  shortDescription   String?   @db.Text
  fullDescription    String?   @db.Text
  location           String?
  clientLogo         String?
  techStack          Json      @default("[]")
  challengePoints    Json      @default("[]")
  obstacles          Json      @default("[]")
  challengeTagline   String?
  challengeResponses Json      @default("[]")
  solutionOptions    Json      @default("[]")
  clientChoice       Int?
  resultSlides       Json      @default("[]")
  testimonialText    String?   @db.Text
  gallery            Json      @default("[]")
  extraMile          String?   @db.Text
  heroImage          String?
  tallImage          String?
  useTallImage       Boolean   @default(false)
  // Which medium fills the pinned project-page frame: "image" or "video".
  heroMediaType      String    @default("image")
  clientGoals        Json      @default("[]")
  challenges         Json      @default("[]")
  results            Json      @default("[]")
  testimonialAuthor  String?
  testimonialRole    String?
  testimonialCompany String?
  extraMilePlanned   String?   @db.Text

  attachments Attachment[]
  services    ProjectService[]
}

model TechItem {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  iconUrl   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientItem {
  id        String   @id @default(cuid())
  name      String
  company   String?
  country   String?
  logo      String?
  website   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  role        String
  roleAr      String?
  bio         String?  @db.Text
  bioAr       String?  @db.Text
  photo       String?
  linkedinUrl String?
  twitterUrl  String?
  email       String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  title         String
  titleAr       String?
  slug          String   @unique
  description   String?  @db.Text
  descriptionAr String? @db.Text
  shortDescription String? @db.Text
  tagline      String?
  benefits     Json     @default("[]")
  deliverables Json     @default("[]")
  process      Json     @default("[]")
  techStack    Json     @default("[]")
  featured     Boolean  @default(false)
  seoTitle     String?
  seoDescription String? @db.Text
  icon          String?
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  faq              Json     @default("[]")
  ctaHeadline      String?
  ctaSubtext       String?  @db.Text
  ctaButtonLabel   String?
  ctaButtonLink    String?

  attachments Attachment[]
  projects    ProjectService[]
}

model MediaAsset {
  id           String       @id @default(cuid())
  url          String       @unique
  filename     String?
  originalName String?
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  caption      String?      @db.Text
  folder       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attachments Attachment[]
}

model Attachment {
  id        String   @id @default(cuid())
  mediaId   String
  projectId String?
  serviceId String?
  theme     String?
  role      String
  order     Int      @default(0)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  project Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([projectId, role, theme])
  @@index([serviceId, role, theme])
  @@index([mediaId])
}

model ProjectService {
  projectId String
  serviceId String
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
  @@index([serviceId])
}

model ContactPage {
  id           Int      @id @default(autoincrement())
  headline     String?
  headlineAr   String?
  subheadline  String?
  subheadlineAr String?
  email        String?
  phone        String?
  address      String?
  addressAr    String?
  socialLinks  Json     @default("{}")
  updatedAt    DateTime @updatedAt
}

model AboutPage {
  id        Int      @id @default(autoincrement())
  stats     Json     @default("[]")
  story     Json     @default("[]")
  mission   String?  @db.Text
  vision    String?  @db.Text
  updatedAt DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  titleAr     String?
  excerpt     String?    @db.Text
  excerptAr   String?    @db.Text
  content     String     @default("") @db.Text
  contentAr   String?    @db.Text
  coverImage  String?
  heroImage   String?
  tags        String[]
  tagsAr      String[]   @default([])
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Inquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  projectType String?
  message     String        @db.Text
  contactMethod String?
  contactValue  String?
  source      String?
  audioUrls   String[]      @default([])
  assetNames  String[]      @default([])
  metadata    Json          @default("{}")
  status      InquiryStatus @default(NEW)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
}
